  "type": "module",
  "scripts": {
    "prepare": "husky",
    "hooks:test": "node scripts/hooks/guard.mjs --self-test",
    "stage": "node devtools/run.mjs stage",
    "gstage": "node devtools/run.mjs stage",
    "commit": "node devtools/run.mjs commit",
    "push": "node devtools/run.mjs push",
        "pull": "node devtools/run.mjs pull",
        "push:test": "bash devtools/push.test.sh",
    "type-check": "tsc --noEmit",
    "verify": "node scripts/hooks/run.mjs verify",
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc && pnpm run build:bundle",
    "build:bundle": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "vitest run --project unit",
    "audit:choices": "node scripts/audit-choice-fields.mjs",
    "audit:buttons": "node scripts/audit-buttons.mjs",
    "audit:buttons:check": "node scripts/audit-buttons.mjs --check",
    "test:watch": "vitest --project unit",
    "preview": "vite preview",
    "lint:ui:baseline": "eslint \"src/**/*.{ts,tsx}\" -f json > .eslint-ui-tmp.json; node scripts/gen-ui-baseline.cjs < .eslint-ui-tmp.json; rm -f .eslint-ui-tmp.json",
    "test:tasks": "esbuild src/app/pages/employee/tasks/__tests__/taskDomain.test.ts --bundle --platform=node --format=esm --outfile=.task-tests/taskDomain.test.mjs --external:node:* --log-level=warning && node --test .task-tests/taskDomain.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook",
    "visual:login": "playwright test --project=login --headed",
    "visual:baseline": "playwright test --project=light --project=dark --update-snapshots",
    "visual:check": "playwright test --project=light --project=dark",
    "visual:report": "playwright show-report e2e/.visual/report"
  },
